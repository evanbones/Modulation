{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "accessWidener": "${access_widener}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/evanbones/Modulation",
    "sources": "https://github.com/evanbones/Modulation"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.evandev.modulation.fabric.ModulationFabric"
    ],
    "client": [
      "com.evandev.modulation.fabric.client.ModulationFabricClient"
    ],
    "modmenu": [
      "com.evandev.modulation.fabric.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "yet_another_config_lib_v3": ">=${yacl_version}",
    "modmenu": "*",
    "emi": "*",
    "jei": "*",
    "sodium": "*",
    "polytone": "*",
    "figura": "*",
    "trinkets": "*",
    "vanillabackport": "*",
    "farmersdelight": "*",
    "connectiblechains": "*"
  }
}
